# Required: Portkey LLM gateway
PORTKEY_API_KEY=
PORTKEY_CONFIG_ID=

# Required: Qdrant vector database
QDRANT_CLUSTER_ENDPOINT=
QDRANT_API_KEY=

# Required for ingestion and retrieval embeddings
GEMINI_API_KEY=

# Required for direct Groq usage and evaluation judging
GROQ_API_KEY=

# Optional: separate Groq keys for fallback and evaluation
GROQ_FALLBACK_API_KEY=
JUDGE_GROQ=

# Optional: online Logfire observability
LOGFIRE_TOKEN=

# Streamlit and evaluation clients
BACKEND_URL=http://localhost:8000

# Optional: LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rag_scale_test
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
